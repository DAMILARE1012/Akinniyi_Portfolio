# Public URL the site will be deployed to (no trailing slash).
# Used for canonical links, Open Graph tags, structured data, robots.txt and sitemap.xml.
VITE_SITE_URL=https://abrahamakinniyi.com

# Optional: Formspree (or any JSON POST) endpoint for the contact form,
# e.g. https://formspree.io/f/xxxxxxx. When empty, the form opens a
# pre-filled WhatsApp chat instead.
VITE_CONTACT_ENDPOINT=
